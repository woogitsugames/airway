<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- [night-12p] D-124: three r170 renders only through WebGL 2, which the WebView builds on OpenGL ES 3.0.
         Required, so Google Play hides the game from devices that would show a blank globe. -->
    <uses-feature android:glEsVersion="0x00030000" android:required="true" />
    <application
        android:allowBackup="true"
        android:fullBackupContent="@xml/backup_rules"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:localeConfig="@xml/locales_config"
        android:appCategory="game"
        android:hardwareAccelerated="true"
        android:resizeableActivity="true"
        android:supportsRtl="true"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="@string/app_name"
        android:theme="@style/AppTheme">
        <!-- [task-24] Explicit configChanges prevents activity recreation when a foldable
             unfolds or the user rotates/resizes the window. No orientation lock. -->
        <activity
            android:name=".MainActivity"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|screenLayout|density|locale|layoutDirection|fontScale|uiMode|navigation|colorMode"
            android:resizeableActivity="true"
            android:windowSoftInputMode="adjustResize"
            android:launchMode="singleTask"
            android:enableOnBackInvokedCallback="true"
            android:exported="true"
            android:theme="@style/AppTheme.NoActionBarLaunch">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- [night-12ay] R3i (D-245): Firebase Test Lab game loop. GameLoopPlugin reads the "scenario" extra,
                 the game plays it (src/game/gameLoop.ts) and the report goes to the intent's data URI. -->
            <intent-filter>
                <action android:name="com.google.intent.action.TEST_LOOP" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="application/javascript" />
            </intent-filter>
        </activity>
        <!-- [night-12ay] Scenario count and labels = GAME_LOOP_SCENARIOS (test:game-loop). -->
        <meta-data android:name="com.google.test.loops" android:value="1" />
        <meta-data android:name="com.google.test.loops.perf" android:value="1" />
    </application>
</manifest>
