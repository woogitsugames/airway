<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-permission android:name="android.permission.INTERNET" />
    <application
        android:allowBackup="false"
        android:appCategory="game"
        android:hardwareAccelerated="true"
        android:resizeableActivity="true"
        android:supportsRtl="true"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="@string/app_name"
        android:theme="@style/AppTheme">
        <!-- [task-24] Explicit configChanges prevents activity recreation when a foldable
             unfolds or the user rotates/resizes the window. No orientation lock. -->
        <activity
            android:name=".MainActivity"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|screenLayout|density|locale|layoutDirection|fontScale|uiMode|navigation|colorMode"
            android:resizeableActivity="true"
            android:windowSoftInputMode="adjustResize"
            android:launchMode="singleTask"
            android:enableOnBackInvokedCallback="true"
            android:exported="true"
            android:theme="@style/AppTheme.NoActionBarLaunch">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>
</manifest>
