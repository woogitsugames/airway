<?xml version="1.0" encoding="utf-8"?>
<!-- [night-12c] D-92: Android 12+ backup and device transfer. Include-only: the save slots (Preferences
     CapacitorStorage + Filesystem Directory.Data files) and WebView localStorage (logbook, streak, settings,
     puzzle stars, tutorial). Nothing else leaves the phone: the install marker aw-install-v1.json stays behind,
     so a restored phone drops the leaderboard identity and queue on first launch (src/platform/install.ts).
     Keep the paths in step with src/platform/storage.ts; test:android-config checks them. -->
<data-extraction-rules>
    <cloud-backup>
        <include domain="sharedpref" path="CapacitorStorage.xml" />
        <include domain="file" path="aw-save-a.json" />
        <include domain="file" path="aw-save-b.json" />
        <include domain="root" path="app_webview/Default/Local Storage/" />
        <include domain="root" path="app_webview/Local Storage/" />
    </cloud-backup>
    <device-transfer>
        <include domain="sharedpref" path="CapacitorStorage.xml" />
        <include domain="file" path="aw-save-a.json" />
        <include domain="file" path="aw-save-b.json" />
        <include domain="root" path="app_webview/Default/Local Storage/" />
        <include domain="root" path="app_webview/Local Storage/" />
    </device-transfer>
</data-extraction-rules>
