<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- [task-24] Transparent system bars: Android 15+ is edge-to-edge by default.
         Capacitor 8 SystemBars supplies WebView safe-area inset values.
         [night-81a] T6 (D-336): the game sits on UI-A's dark enamel (#0E0F0F), so the bar icons are light and the window
         is enamel like the launch screen (no paper or white flash before the first frame; Linoryt's paper bars, D-305,
         are gone). -->
    <style name="AppTheme" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar">false</item>
        <item name="android:windowLayoutInDisplayCutoutMode">shortEdges</item>
        <item name="android:windowActionModeOverlay">true</item>
        <item name="android:windowBackground">@color/airway_enamel</item>
    </style>

    <!-- BridgeActivity switches to this exact style in onCreate(). -->
    <style name="AppTheme.NoActionBar" parent="AppTheme">
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
        <item name="android:background">@null</item>
    </style>

    <style name="AppTheme.NoActionBarLaunch" parent="Theme.SplashScreen">
        <!-- [night-78a] Z, D-333: the launch screen is the mark on black enamel; [night-81a] T6: so are the window and bars. -->
        <item name="windowSplashScreenBackground">@color/airway_enamel</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/splash</item>
        <item name="postSplashScreenTheme">@style/AppTheme.NoActionBar</item>
    </style>
</resources>
