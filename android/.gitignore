# Packaged web and runtime metadata are regenerated by cap sync.
app/src/main/assets/public/
app/src/main/assets/capacitor.config.json
app/src/main/assets/capacitor.plugins.json
# Native raster assets are recreated from versioned SVG by npm run android:assets.
app/src/main/res/mipmap-*/ic_launcher*.png
app/src/main/res/drawable-nodpi/splash.png
# Signing secrets belong outside the repository.
*.keystore
*.jks
key.properties
