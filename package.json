{
  "name": "airway-network-game",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Airway — deterministic airline-network game on a 3D globe.",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "test:i18n": "node scripts/test-i18n.mjs",
    "test:arch": "node scripts/test-arch.mjs",
    "test:rng": "node --experimental-strip-types scripts/test-rng.ts",
    "test:sim-kernel": "node --experimental-strip-types scripts/test-sim-kernel.ts",
    "test:undo": "node --experimental-strip-types scripts/test-undo.ts",
    "test:daily": "node --experimental-strip-types scripts/test-daily.ts",
    "test:fast": "npm run typecheck && npm run test:i18n && npm run test:arch && npm run test:rng && npm run test:sim-kernel && npm run test:undo && npm run test:daily && npm run test:cities && npm run test:spawner && npm run test:geo-math && npm run test:gestures && npm run test:overlay-layout && npm run test:routing && npm run test:hubs && npm run test:sim-week && npm run test:route-tool && npm run test:interp && npm run test:daynight && npm run test:flap && npm run test:causes && npm run test:saves && npm run test:audio-sched && npm run test:cvd && npm run test:contrast && npm run test:puzzles && npm run test:daily-mode",
    "shots": "node scripts/shots.mjs && node dev/shots.mjs",
    "shots:mockups": "node mockups/shoot.mjs",
    "mockups": "node mockups/build-all.mjs",
    "prebuild": "npm run build:distances && npm run build:land",
    "build:distances": "node scripts/build-distances.mjs",
    "test:cities": "node scripts/test-cities.mjs",
    "test:spawner": "node scripts/test-spawner.mjs",
    "build:land": "node scripts/build-land.mjs",
    "test:geo-math": "node src/render/globe/test-geo-math.mjs",
    "shots:globe": "node dev/shots.mjs",
    "test:gestures": "node scripts/test-gestures.mjs",
    "shots:04": "node scripts/shots.mjs",
    "test:overlay-layout": "node scripts/test-overlay-layout.mjs",
    "shots:06": "node scripts/shots.mjs",
    "test:routing": "node scripts/test-routing.mjs",
    "test:hubs": "node scripts/test-hubs.mjs",
    "test:sim-week": "node scripts/test-sim-week.mjs",
    "shots:08": "node scripts/shots.mjs",
    "test:planes": "node scripts/test-planes.mjs",
    "test:schedule": "node scripts/test-schedule.mjs",
    "shots:09": "node scripts/shots.mjs",
    "test:route-tool": "node scripts/test-route-tool.mjs",
    "shots:07": "node scripts/shots.mjs",
    "test:interp": "node scripts/test-interp.mjs",
    "shots:10": "node scripts/shots.mjs",
    "test:daynight": "node scripts/test-daynight.mjs",
    "shots:11": "node scripts/shots.mjs",
    "test:hud-targets": "node scripts/test-hud-targets.mjs",
    "shots:13": "node scripts/shots.mjs && node scripts/test-hud-targets.mjs",
    "shots:12": "node scripts/shots.mjs",
    "test:upgrades": "node --experimental-strip-types scripts/test-upgrades.mjs",
    "test:flap": "node scripts/test-flap.mjs",
    "shots:14": "node scripts/shots.mjs",
    "shots:14:14": "node scripts/shots-14.mjs",
    "shots:15": "node scripts/shots.mjs",
    "test:causes": "node scripts/test-causes.mjs",
    "test:saves": "node --experimental-strip-types --loader ./scripts/test-saves-loader.mjs scripts/test-saves.mjs",
    "shots:16": "node scripts/shots.mjs",
    "test:audio-sched": "node --experimental-strip-types src/audio/test-audio-sched.mjs",
    "audio:demo": "node --experimental-strip-types src/audio/demo-wav.mjs",
    "shots:19": "node scripts/shots.mjs",
    "shots:20": "node scripts/shots.mjs",
    "test:cvd": "node scripts/check-cvd.mjs",
    "test:contrast": "node scripts/check-contrast.mjs",
    "test:puzzles": "node scripts/test-puzzles.mjs",
    "shots:17": "node scripts/shots.mjs",
    "shots:puzzles": "node scripts/shots-puzzles.mjs",
    "shots:18": "node scripts/shots.mjs",
    "test:daily-mode": "node --experimental-strip-types scripts/test-daily-mode.mjs"
  },
  "dependencies": {
    "@capacitor/android": "8.5.3",
    "@capacitor/core": "8.5.3",
    "@capacitor/ios": "8.5.3",
    "three": "0.170.0",
    "@capacitor/haptics": "8.0.2",
    "@capacitor/share": "8.0.1"
  },
  "devDependencies": {
    "@types/three": "0.170.0",
    "d3-geo": "3.1.1",
    "topojson-client": "3.1.0",
    "typescript": "5.9.3",
    "vite": "6.3.6",
    "world-atlas": "2.0.2"
  }
}
