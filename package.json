{
  "name": "airway-network-game",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Airway — deterministic airline-network game on a 3D globe.",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc --noEmit && vite build",
    "prebuild": "npm run build:distances && npm run build:land",
    "typecheck": "tsc --noEmit",
    "build:distances": "node scripts/build-distances.mjs",
    "build:land": "node scripts/build-land.mjs",
    "build:site": "node site/build.mjs",
    "test:fast": "node scripts/run-suite.mjs test:fast typecheck test:i18n test:rng test:sim-kernel test:undo test:daily test:cities test:spawner test:land test:geo-math test:gestures test:overlay-layout test:routing test:hubs test:sim-week test:planes test:schedule test:route-tool test:interp test:render-layers test:daynight test:upgrades test:flap test:causes test:saves test:audio-sched test:cvd test:contrast test:puzzles test:daily-mode test:balance:fixture test:gating test:android-config test:ios-config test:store-shots test:site test:replay test:balance test:week-source test:arch",
    "test:ci": "node scripts/run-suite.mjs test:ci test:fast build test:hud-targets test:e2e:tutorial test:e2e:smoke ui:matrix test:balance test:perf-scene shots shots:site store:shots",
    "test:i18n": "node scripts/test-i18n.mjs",
    "test:arch": "node scripts/test-arch.mjs",
    "test:week-source": "node scripts/test-week-source.mjs",
    "test:rng": "node --import ./scripts/ts-test-loader.mjs scripts/test-rng.ts",
    "test:sim-kernel": "node --import ./scripts/ts-test-loader.mjs scripts/test-sim-kernel.ts",
    "test:undo": "node --import ./scripts/ts-test-loader.mjs scripts/test-undo.ts",
    "test:daily": "node --import ./scripts/ts-test-loader.mjs scripts/test-daily.ts",
    "test:cities": "node scripts/test-cities.mjs",
    "test:spawner": "node scripts/test-spawner.mjs",
    "test:land": "node scripts/build-land.mjs --check",
    "test:geo-math": "node src/render/globe/test-geo-math.mjs",
    "test:gestures": "node scripts/test-gestures.mjs",
    "test:overlay-layout": "node scripts/test-overlay-layout.mjs",
    "test:routing": "node scripts/test-routing.mjs",
    "test:hubs": "node scripts/test-hubs.mjs",
    "test:sim-week": "node scripts/test-sim-week.mjs",
    "test:replay": "node scripts/test-replay.mjs",
    "test:planes": "node scripts/test-planes.mjs",
    "test:schedule": "node scripts/test-schedule.mjs",
    "test:route-tool": "node scripts/test-route-tool.mjs",
    "test:interp": "node scripts/test-interp.mjs",
    "test:daynight": "node scripts/test-daynight.mjs",
    "test:upgrades": "node --import ./scripts/ts-test-loader.mjs scripts/test-upgrades.mjs",
    "test:flap": "node scripts/test-flap.mjs",
    "test:causes": "node scripts/test-causes.mjs",
    "test:saves": "node --import ./scripts/ts-test-loader.mjs scripts/test-saves.mjs",
    "test:audio-sched": "node --experimental-strip-types src/audio/test-audio-sched.mjs",
    "test:cvd": "node scripts/check-cvd.mjs",
    "test:contrast": "node scripts/check-contrast.mjs",
    "test:puzzles": "node scripts/test-puzzles.mjs",
    "test:daily-mode": "node --import ./scripts/ts-test-loader.mjs scripts/test-daily-mode.mjs",
    "test:gating": "node scripts/test-gating.mjs",
    "test:balance": "node --import ./scripts/ts-test-loader.mjs scripts/balance-report.ts --test",
    "test:balance:fixture": "node --import ./scripts/ts-test-loader.mjs scripts/balance-report.ts --test --fixture",
    "test:android-config": "node scripts/test-android-config.mjs",
    "test:ios-config": "node ios/scripts/test-ios-config.mjs",
    "test:store-shots": "node scripts/store-shots.mjs --validate",
    "test:site": "node site/test.mjs",
    "test:hud-targets": "node scripts/test-hud-targets.mjs",
    "test:e2e:tutorial": "node scripts/test-e2e-tutorial.mjs",
    "test:e2e:smoke": "node e2e/smoke.mjs",
    "test:e2e:fixture": "node e2e/smoke.mjs --fixture && node scripts/ui-matrix.mjs --fixture",
    "ui:matrix": "node scripts/ui-matrix.mjs",
    "perf:scene": "node --experimental-strip-types scripts/perf-scene.ts",
    "test:perf-scene": "npm run perf:scene",
    "shots": "node scripts/shots.mjs",
    "shots:site": "npm run build:site && node site/shots.mjs",
    "store:shots": "node scripts/store-shots.mjs",
    "mockups": "node mockups/build-all.mjs",
    "shots:mockups": "node mockups/shoot.mjs",
    "balance:report": "node --import ./scripts/ts-test-loader.mjs scripts/balance-report.ts --report",
    "balance:fixture": "node --import ./scripts/ts-test-loader.mjs scripts/balance-report.ts --report --fixture",
    "audio:demo": "node --experimental-strip-types src/audio/demo-wav.mjs",
    "android": "node scripts/build-android.mjs",
    "android:assets": "node scripts/build-android.mjs --assets-only",
    "android:release": "node scripts/build-android.mjs --release-apk",
    "android:aab": "node scripts/build-android.mjs --release-aab",
    "test:render-layers": "node scripts/test-render-layers.mjs",
    "shots:world": "node dev/shots.mjs world",
    "shots:34": "node scripts/shots-34.mjs"
  },
  "dependencies": {
    "@capacitor/android": "8.5.3",
    "@capacitor/core": "8.5.3",
    "@capacitor/filesystem": "8.1.5",
    "@capacitor/haptics": "8.0.2",
    "@capacitor/ios": "8.5.3",
    "@capacitor/preferences": "8.0.1",
    "@capacitor/share": "8.0.1",
    "three": "0.170.0"
  },
  "devDependencies": {
    "@types/three": "0.170.0",
    "d3-geo": "3.1.1",
    "topojson-client": "3.1.0",
    "typescript": "5.9.3",
    "vite": "6.3.6",
    "world-atlas": "2.0.2"
  }
}
