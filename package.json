{
  "name": "airway-network-game",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Airway — deterministic airline-network game on a 3D globe.",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "test:i18n": "node scripts/test-i18n.mjs",
    "test:arch": "node scripts/test-arch.mjs",
    "test:rng": "node --experimental-strip-types scripts/test-rng.ts",
    "test:sim-kernel": "node --experimental-strip-types scripts/test-sim-kernel.ts",
    "test:undo": "node --experimental-strip-types scripts/test-undo.ts",
    "test:daily": "node --experimental-strip-types scripts/test-daily.ts",
    "test:fast": "npm run typecheck && npm run test:i18n && npm run test:arch && npm run test:rng && npm run test:sim-kernel && npm run test:undo && npm run test:daily && npm run test:cities && npm run test:spawner",
    "shots": "node scripts/shots.mjs",
    "shots:mockups": "node mockups/shoot.mjs",
    "mockups": "node mockups/build-all.mjs",
    "prebuild": "npm run build:distances",
    "build:distances": "node scripts/build-distances.mjs",
    "test:cities": "node scripts/test-cities.mjs",
    "test:spawner": "node scripts/test-spawner.mjs"
  },
  "dependencies": {
    "@capacitor/android": "8.5.3",
    "@capacitor/core": "8.5.3",
    "@capacitor/ios": "8.5.3",
    "three": "0.170.0"
  },
  "devDependencies": {
    "@types/three": "0.170.0",
    "d3-geo": "3.1.1",
    "topojson-client": "3.1.0",
    "typescript": "5.9.3",
    "vite": "6.3.6",
    "world-atlas": "2.0.2"
  }
}
