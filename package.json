{
  "name": "airway-network-game",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Airway — deterministic airline-network game on a 3D globe.",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "test:i18n": "node scripts/test-i18n.mjs",
    "test:arch": "node scripts/test-arch.mjs",
    "test:fast": "npm run typecheck && npm run test:i18n && npm run test:arch && npm run test:geo-math",
    "shots": "node scripts/shots.mjs && node dev/shots.mjs",
    "shots:mockups": "node mockups/shoot.mjs",
    "mockups": "node mockups/build-all.mjs",
    "build:land": "node scripts/build-land.mjs",
    "prebuild": "npm run build:land",
    "test:geo-math": "node src/render/globe/test-geo-math.mjs",
    "shots:globe": "node dev/shots.mjs"
  },
  "dependencies": {
    "@capacitor/android": "8.5.3",
    "@capacitor/core": "8.5.3",
    "@capacitor/ios": "8.5.3",
    "three": "0.170.0"
  },
  "devDependencies": {
    "@types/three": "0.170.0",
    "d3-geo": "3.1.1",
    "topojson-client": "3.1.0",
    "typescript": "5.9.3",
    "vite": "6.3.6",
    "world-atlas": "2.0.2"
  }
}
